    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run: App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            // "args": "${command:pickArgs}"
        },
        {
            "name": "Run: Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/main.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
            // "args": "${command:pickArgs}"
        }
    ]
}